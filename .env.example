# ---------------------------------------------------------------
# Suporte Omnis - variáveis de ambiente
# Copie para .env (nunca versionado) e preencha os valores.
# Em produção, os segredos vêm do Azure Key Vault.
# ---------------------------------------------------------------

# Caixa de email monitorada (Microsoft 365 / Outlook)
MAILBOX_ADDRESS=suporte@dataomnis.com.br

# Registro de aplicativo no Microsoft Entra ID (scripts/setup-graph-app.ps1)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Equipe que recebe os atendimentos complexos (separados por vírgula)
ESCALATION_RECIPIENTS=caio.p@datagroup.global,matheus.gavioli@datagroup.global,thiago.dourado@grupodata.com.br

# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# PostgreSQL. Local: postgresql://postgres:postgres@localhost:5432/suporte_omnis
# Azure: postgresql://USUARIO:SENHA@SERVIDOR.postgres.database.azure.com:5432/suporte_omnis?sslmode=require
DATABASE_URL=

# true = lê e classifica os emails, mas não envia nada, não marca como lido
# e não grava no banco. Use para validar antes de ligar de verdade.
DRY_RUN=true

# Regras de atendimento
MIN_CONFIDENCE_AUTO_REPLY=0.8
MAX_MESSAGES_PER_RUN=25
MAX_ATTEMPTS=3
SEND_ACKNOWLEDGEMENT=true
SIGNATURE=Equipe de Suporte Omnis
# Ignora emails recebidos antes desta data (evita responder o histórico antigo)
PROCESS_SINCE=2026-09-24T00:00:00Z
KNOWLEDGE_DIR=knowledge
LOG_LEVEL=INFO
